---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout title="T3 Azur" lang="fr">
  <div class="mx-auto max-w-6xl px-6 py-10">
    <h1 class="text-3xl font-semibold">T3 Azur</h1>
    <p class="mt-2 text-slate-700">Idéal pour les familles, appartement spacieux avec deux lits queen, proche des plages et des commerces.</p>
    <ul class="mt-4 text-sm text-slate-700 grid grid-cols-1 md:grid-cols-2 gap-2">
      <li>55 m²</li>
      <li>Jusqu’à 4 personnes</li>
      <li>2 lits queen</li>
      <li>Climatisation, Wi‑Fi, cuisine équipée</li>
      <li>Lit bébé sur demande</li>
      <li>Parking sécurisé</li>
      <li>Séjour minimum: 3 nuits</li>
      <li>Arrivée 14:00 / Départ 11:00</li>
    </ul>
    <div class="mt-6 flex gap-3">
      <a href="/fr/contact/" class="inline-flex items-center rounded-lg bg-[#1EBBCE] px-4 py-2 text-white hover:bg-[#138A9A]">Envoyer une demande</a>
      <a href="https://airbnb.fr/h/villafleurie-t3" target="_blank" rel="noopener" class="inline-flex items-center rounded-lg border border-slate-200 px-4 py-2">Réserver sur Airbnb (T3)</a>
    </div>
  </div>
</BaseLayout>

